    <motor name="a_root_ry" joint="a_root_ry" gear="250" ctrlrange="-1 1"/>
    <motor name="a_head" joint="a_head" gear="20" ctrlrange="-1 1"/>
    <motor name="a_shoulder_r" joint="a_shoulder_r" gear="45" ctrlrange="-1 1"/>
    <motor name="a_elbow_r" joint="a_elbow_r" gear="30" ctrlrange="-1 1"/>
    <motor name="a_shoulder_l" joint="a_shoulder_l" gear="45" ctrlrange="-1 1"/>
    <motor name="a_elbow_l" joint="a_elbow_l" gear="30" ctrlrange="-1 1"/>
    <motor name="a_hip_r" joint="a_hip_r" gear="60" ctrlrange="-1 1"/>
    <motor name="a_knee_r" joint="a_knee_r" gear="40" ctrlrange="-1 1"/>
    <motor name="a_hip_l" joint="a_hip_l" gear="60" ctrlrange="-1 1"/>
    <motor name="a_knee_l" joint="a_knee_l" gear="40" ctrlrange="-1 1"/>
    <motor name="b_root_x" joint="b_root_x" gear="90" ctrlrange="-1 1"/>
